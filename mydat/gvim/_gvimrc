"----------------------------------------------------------
" 表の整形
"----------------------------------------------------------
function! AlignTableCommand(...) range
    " デフォルトの区切り文字を空白に設定
    let delimiter = '\s\+'
    if len(a:000) > 0
        " 引数で区切り文字が指定されている場合、使用する
        let delimiter = a:000[0]
    endif

    if len(a:000) > 1
        " 引数で区切り文字が指定されている場合、使用する
        let aftreplacement = a:000[1]
    else
        let aftreplacement = delimiter
    endif

    "echom"使用する区切り文字: " . delimiter
    "echom"置換後区切り文字:   " . aftreplacement

    " ビジュアル選択範囲の取得
    let [lnum_start, col_start] = getpos("'<")[1:2]
    let [lnum_end, col_end] = getpos("'>")[1:2]

    " ビジュアルモードでない場合は、バッファ全体を対象にする
    if lnum_start == 1 && lnum_end == 1
        "echom"ノーマルモード" . lnum_start . lnum_end
        let lnum_start = 1
        let lnum_end = line('$')
    endif
    "echom"処理対象範囲: " . lnum_start . " - " . lnum_end

    " 選択範囲またはバッファ全体の行を取得
    let lines = getline(lnum_start, lnum_end)
    if lnum_start == lnum_end
        let lines = [lines[0][col_start - 1 : col_end - 1]]
    else
        let lines[0] = lines[0][col_start - 1:]
        let lines[-1] = lines[-1][:col_end - 1]
    endif
    "echom"選択範囲の内容: " . join(lines, "\n")

    " 各行を分割し、列の最大幅を計算
    let columns = []
    let split_lines = []
    for line in lines
        " 区切り文字で分割しつつ、保持するために配列に格納
        let fields = split(line, '\zs' . delimiter . '\ze')
        let split_lines += [fields]
        "echom"行内容: " . line
        "echom"分割結果: " . string(fields)
        for i in range(len(fields))
            let width = strwidth(fields[i])
            if len(columns) <= i
                call add(columns, width)
                "echom"列" . i . "の初期幅: " . width
            else
                let columns[i] = max([columns[i], width])
                "echom"列" . i . "の更新幅: " . columns[i]
            endif
        endfor
    endfor
    "echom"列ごとの最大幅: " . string(columns)

    " 各行を整列し、区切り文字を再構築
    let result = []
    for fields in split_lines
        let new_line = ''
        for i in range(len(fields))
            let padding = columns[i] - strwidth(fields[i]) + 1
            if i == len(fields) - 1
                " 最後の列にはパディングを追加しない
                let new_line .= fields[i]
            else
                if aftreplacement == '\s\+'
                    let new_line .= fields[i] . repeat(' ', padding) . substitute(' ', '\s\+', ' ', 'g')
                else
                    let new_line .= fields[i] . repeat(' ', padding) . substitute(aftreplacement, '\s\+', ' ', 'g')
                endif
            endif
        endfor
        call add(result, new_line)
        "echom"整列後の行: " . new_line
    endfor

    " 結果をバッファに反映
    call setline(lnum_start, result)
    "echom"整列処理が完了しました"
endfunction

" カスタムコマンドを定義
command! -range -nargs=* AlignTable call AlignTableCommand(<f-args>)


