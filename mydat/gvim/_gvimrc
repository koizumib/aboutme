function! ShortcutCmd(replace_from, replace_to)
    " コマンドがビジュアル範囲置換か普通の:sコマンドかチェック
    let cmd = getcmdtype() .. getcmdline()
    if match(cmd, "^:" . a:replace_from) >= 0
        " getchar()を実行して置換後の文字列を準備し、feedkeysでカーソルを移動
        call feedkeys("\<backspace>%" . a:replace_to, 'n')
        call feedkeys("\<left>\<left>", 'n')
        return ''
    elseif match(cmd, "^:'<,'>" . a:replace_from) >= 0
        " getchar()を実行して置換後の文字列を準備し、feedkeysでカーソルを移動
        call feedkeys("\<backspace>" . a:replace_to, 'n')
        call feedkeys("\<left>\<left>", 'n')
        return ''
    endif
    " 条件が一致しない場合は置換前文字列を返す
    return a:replace_from
endfunction

