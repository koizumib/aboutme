"----------------------------------------------------------
" tabchangeコマンドでファイル内のタブをスペースに変換
"----------------------------------------------------------
function! ToggleExpandTab()
	" expandtabが設定されているかチェック
	if &expandtab
		" expandtabが設定されていれば無効にする
		set noexpandtab
		" ここで必要ならばretabを実行
		" retab! 4 など、必要に応じて設定
	else
		" expandtabが設定されていなければ有効にする
		set expandtab
		" expandtabを有効にした後でretabを実行
		retab 8
	endif
endfunction
" カスタムコマンドを定義し、上記の関数を実行
command Tabchange call ToggleExpandTab()
